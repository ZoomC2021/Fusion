{
  "name": "@fusion-plugin-examples/agy-runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "Antigravity CLI (agy) runtime plugin for Fusion",
  "keywords": [
    "fusion-plugin",
    "agy",
    "antigravity",
    "runtime"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./probe": {
      "types": "./src/probe.ts",
      "source": "./src/probe.ts",
      "import": "./dist/probe.js"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --silent=passed-only --reporter=dot"
  },
  "dependencies": {
    "@fusion/core": "workspace:*",
    "@fusion-plugin-examples/acp-runtime": "workspace:*",
    "@fusion/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
